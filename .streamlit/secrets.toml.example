# Template for the dashboard's database settings.
# Copy to .streamlit/secrets.toml (git-ignored) and fill in your own values.
# Use a read-only user, e.g. the one created by sql/dashboard_role.sql.

[db]
host = "your-host.neon.tech"
port = 5432
dbname = "fuel_prices"
user = "dashboard_reader"
password = "your-password"
sslmode = "require"
