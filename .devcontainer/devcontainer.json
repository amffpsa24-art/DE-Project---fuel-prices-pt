{
  "name": "Fuel Prices PT",
  // Same Python version as the project and CI
  "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",
  "customizations": {
    "codespaces": {
      // secrets.toml is created from the template below: fill it in, then run the dashboard
      "openFiles": [
        "README.md",
        ".streamlit/secrets.toml"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // Pipeline + test tools + dashboard dependencies; never overwrites an existing secrets.toml
  "updateContentCommand": "pip install --user -r requirements-dev.txt -r dashboard/requirements.txt && cp -n .streamlit/secrets.toml.example .streamlit/secrets.toml",
  // Run the dashboard with: streamlit run dashboard/app.py
  "portsAttributes": {
    "8501": {
      "label": "Dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
