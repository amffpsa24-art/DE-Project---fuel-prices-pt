# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored: never commit real passwords.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-password-here
PGDATABASE=fuel_prices

# Bronze layer in Azure (optional): without it, the raw JSON is kept in data/bronze/ only
# Use a SAS connection string (Read, Write, Create; no Delete), not the account key. See README: How to run
# AZURE_STORAGE_CONNECTION_STRING=BlobEndpoint=https://<account>.blob.core.windows.net/;SharedAccessSignature=sv=...
# AZURE_STORAGE_CONTAINER=bronze
