# virtual environment: anyone can rebuild it from requirements.txt
.venv/

# Python cache files, generated automatically
__pycache__/

# Jupyter autosave files
.ipynb_checkpoints/

# pipeline output: data snapshots don't belong in the code repo
data/

# VS Code workspace settings: editor-specific, not part of the project
*.code-workspace

# all environment files contain credentials, except the template
.env*
!.env.example

# Streamlit secrets: contains the dashboard's database password
.streamlit/secrets.toml

# Notes: work logs stay private, the API discovery note is public
notes/*
!notes/api-discovery.md

# Notebooks: only the API exploration notebook is public
notebooks/*
!notebooks/dgeg_client.ipynb

# Keep the data folder
!notebooks/data/

# Ignore everything inside data
notebooks/data/*
# Keep this specific CSV
!notebooks/data/fuel_prices_raw.csv

.pytest_cache/
.ruff_cache/